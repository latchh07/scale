PORT=3000

# Leave blank while using anomalyResult in local requests.
# Set this to the SAP AI Core deployment inference route:
# https://.../v2/inference/deployments/<deployment-id>/v1/models/risk-anomaly:infer
ANOMALY_SERVICE_URL=

# Temporary local option only. In SAP BTP, prefer a service binding or Destination.
ANOMALY_BEARER_TOKEN=

# SAP AI Core client-credentials flow. Do not commit real values.
AI_AUTH_URL=
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_RESOURCE_GROUP=team-12

# Demo default. Restrict this to the frontend origin before production.
ALLOWED_ORIGIN=*

# SAP HANA connection. Keep real values in a local .env or BTP service binding.
HANA_HOST=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=TEAM_12
HANA_SSL_VALIDATE_CERTIFICATE=false
